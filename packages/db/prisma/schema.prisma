generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model File {
  id         String   @id @default(uuid())
  fileName   String
  mimeType   String // "pdf" | "png" | "jpeg"
  storageKey String // path/key into whatever object storage is used — decided at implementation time
  createdAt  DateTime @default(now())

  companyLogoFor           Company[] @relation("CompanyLogo")
  companyAnmeCertificateFor Company[] @relation("CompanyAnmeCertificate")

  pvModuleDatasheetFor      PvModule[]   @relation("PvModuleDatasheet")
  pvModuleHomologationFor   PvModule[]   @relation("PvModuleHomologation")
  inverterDatasheetFor      Inverter[]   @relation("InverterDatasheet")
  inverterHomologationFor   Inverter[]   @relation("InverterHomologation")
  spdDatasheetFor           Spd[]        @relation("SpdDatasheet")
  spdHomologationFor        Spd[]        @relation("SpdHomologation")
  dcSwitchDatasheetFor      DcSwitch[]   @relation("DcSwitchDatasheet")
  dcSwitchHomologationFor   DcSwitch[]   @relation("DcSwitchHomologation")
  dcFuseDatasheetFor        DcFuse[]     @relation("DcFuseDatasheet")
  dcFuseHomologationFor     DcFuse[]     @relation("DcFuseHomologation")
  acBreakerDatasheetFor     AcBreaker[]  @relation("AcBreakerDatasheet")
  acBreakerHomologationFor  AcBreaker[]  @relation("AcBreakerHomologation")
  acIsolatorDatasheetFor    AcIsolator[] @relation("AcIsolatorDatasheet")
  acIsolatorHomologationFor AcIsolator[] @relation("AcIsolatorHomologation")
  cableDatasheetFor         Cable[]      @relation("CableDatasheet")
  cableHomologationFor      Cable[]      @relation("CableHomologation")
  accessoryDatasheetFor     Accessory[]  @relation("AccessoryDatasheet")
  accessoryHomologationFor  Accessory[]  @relation("AccessoryHomologation")

  projectStructureAttestationFor ProjectStructure[]  @relation("ProjectStructureAttestation")
  projectSimulationPvsystReportFor ProjectSimulation[] @relation("ProjectSimulationPvsystReport")
  projectImagerySituationImageFor ProjectImagery[]    @relation("SituationImage")
  projectImageryImplantationImageFor ProjectImagery[] @relation("ImplantationImage")
  annexCinFor               ProjectAnnexes[] @relation("AnnexCin")
  annexCommercialRegisterFor ProjectAnnexes[] @relation("AnnexCommercialRegister")
  annexStegContractFor      ProjectAnnexes[] @relation("AnnexStegContract")
  annexLastPaidBillFor      ProjectAnnexes[] @relation("AnnexLastPaidBill")
  annexModuleAcceptanceFor  ProjectAnnexes[] @relation("AnnexModuleAcceptance")
  projectAnnexExtraFiles    ProjectAnnexExtraFile[] @relation("ProjectAnnexExtraFile")
  projectBillImportFor    ProjectBillImport[] @relation("ProjectBillImportFile")
  dossierJobDocxFor       DossierJob[] @relation("DossierJobDocx")
  dossierJobPdfFor        DossierJob[] @relation("DossierJobPdf")
  dossierJobAnnexesPdfFor DossierJob[] @relation("DossierJobAnnexesPdf")
  catalogSourceDocumentFor CatalogSourceDocument[] @relation("CatalogSourceDocumentFile")

  @@map("file")
}

enum BuildingType {
  HOUSE
  APARTMENT_BUILDING
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
}

enum ProjectTier {
  STANDARD
  PREMIUM
}

model Company {
  id                       String    @id @default(uuid())
  name                     String
  shortName                String?
  slogan                   String?
  logoFileId               String?
  logo                     File?     @relation("CompanyLogo", fields: [logoFileId], references: [id])
  address                  String
  phone                    String
  email                    String
  taxId                    String?
  commercialRegister       String?
  legalRepFullName         String
  legalRepRole             String    @default("Gérant")
  anmeCode                 String
  anmeReference            String?
  anmeCategory             String
  anmeValidFrom            DateTime
  anmeValidTo              DateTime
  anmeCertificateFileId    String?
  anmeCertificate          File?     @relation("CompanyAnmeCertificate", fields: [anmeCertificateFileId], references: [id])
  defaultTMinC             Float     @default(-10)
  defaultTMaxC             Float     @default(85)
  defaultMaxVoltageDropPct Float     @default(3)
  defaultMaxAcVoltageDropPct Float   @default(1)
  defaultEarthResistanceTargetOhm Float?
  defaultDesignWindSpeedKmh Float    @default(120)
  defaultCosPhi            Float     @default(0.8)
  /// The installer's own dossier numbering (e.g. `434` in `434 - 303`); null or empty for none.
  dossierPrefix            String?
  /// The last dossier number used; the next first generation takes dossierCounter + 1.
  dossierCounter           Int       @default(0)
  createdAt                DateTime  @default(now())

  users        CompanyUser[]
  subscription Subscription?
  payments     Payment[]
  pvModules    PvModule[]
  inverters    Inverter[]
  spds         Spd[]
  dcSwitches   DcSwitch[]
  dcFuses      DcFuse[]
  acBreakers   AcBreaker[]
  acIsolators  AcIsolator[]
  cables       Cable[]
  accessories  Accessory[]
  projects     Project[]
  libraryItems LibraryItem[]
  billImportAttempts BillImportAttempt[]

  @@map("company")
}

/// One row per paid bill-reading call (successful or not): the daily bill-import cap counts these.
model BillImportAttempt {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("bill_import_attempt")
}

model CompanyUser {
  id           String          @id @default(uuid())
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id])
  email        String          @unique
  passwordHash String
  fullName     String
  role         CompanyUserRole @default(MEMBER)
  createdAt    DateTime        @default(now())

  sessions Session[]

  @@map("company_user")
}

enum CompanyUserRole {
  OWNER
  MEMBER
}

model Session {
  id            String      @id @default(uuid())
  companyUserId String
  companyUser   CompanyUser @relation(fields: [companyUserId], references: [id])
  tokenHash     String      @unique
  createdAt     DateTime    @default(now())
  lastSeenAt    DateTime    @default(now())
  expiresAt     DateTime

  @@map("session")
}

model SuperAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  sessions SuperAdminSession[]

  @@map("super_admin")
}

model SuperAdminSession {
  id           String     @id @default(uuid())
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])
  tokenHash    String     @unique
  createdAt    DateTime   @default(now())
  lastSeenAt   DateTime   @default(now())
  expiresAt    DateTime

  @@map("super_admin_session")
}

model Plan {
  id                  String      @id @default(uuid())
  name                String
  monthlyDossierLimit Int
  priceTnd            Decimal     @db.Decimal(10, 2)
  tier                ProjectTier
  createdAt           DateTime    @default(now())

  subscriptions Subscription[]

  @@map("plan")
}

model Subscription {
  id          String             @id @default(uuid())
  companyId   String             @unique
  company     Company            @relation(fields: [companyId], references: [id])
  planId      String
  plan        Plan               @relation(fields: [planId], references: [id])
  status      SubscriptionStatus @default(ACTIVE)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime           @default(now())

  @@map("subscription")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

model Payment {
  id               String        @id @default(uuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id])
  amountTnd        Decimal       @db.Decimal(10, 2)
  method           PaymentMethod
  gatewayReference String?
  note             String?
  recordedByAdmin  Boolean       @default(true)
  createdAt        DateTime      @default(now())

  @@map("payment")
}

enum PaymentMethod {
  MANUAL
  KONNECT
}

model PvModule {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("PvModuleDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("PvModuleHomologation", fields: [homologationFileId], references: [id])

  pmaxW                 Float
  vmpV                  Float
  impA                  Float
  vocV                  Float
  iscA                  Float
  tempCoeffVocPct       Float
  tempCoeffIscPct       Float
  tempCoeffPmaxPct      Float
  tempCoeffVmpPct       Float?
  irmA                  Float
  maxSystemVoltageV     Float
  bifacial              Boolean  @default(false)
  bifacialGainPct       Float?
  lengthMm              Float
  widthMm               Float
  weightKg              Float
  noctC                 Float?

  createdAt             DateTime @default(now())

  arrayConfigs ProjectArrayConfig[]

  libraryItems LibraryItem[]

  @@map("pv_module")
}

model Inverter {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("InverterDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("InverterHomologation", fields: [homologationFileId], references: [id])

  phases                Int
  pacW                  Float
  sacVA                 Float
  vdcMaxV               Float
  mpptMinV              Float
  mpptMaxV              Float
  startUpV              Float
  mpptCount             Int
  inputsPerMppt         Int
  idcMaxPerMpptA        Float
  iscMaxPerMpptA        Float
  vacNomV               Float
  vacRangeV             String?
  iacMaxA               Float
  integratedDcSwitch    Boolean  @default(false)
  stegApproved          Boolean  @default(false)

  createdAt             DateTime @default(now())

  arrayInverters ProjectArrayInverter[]

  libraryItems LibraryItem[]

  @@map("inverter")
}

model Spd {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("SpdDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("SpdHomologation", fields: [homologationFileId], references: [id])

  side                  SpdSide
  type                  Int
  poles                 Int
  ucV                   Float
  upKV                  Float
  inKA                  Float
  imaxKA                Float
  iscpvKA               Float?

  createdAt             DateTime @default(now())

  protectionsDc ProjectProtections[] @relation("DcSpd")
  protectionsAc ProjectProtections[] @relation("AcSpd")

  libraryItems LibraryItem[]

  @@map("spd")
}

enum SpdSide {
  DC
  AC
}

model DcSwitch {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("DcSwitchDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("DcSwitchHomologation", fields: [homologationFileId], references: [id])

  ratedVoltageV         Float
  ratedCurrentA         Float
  poles                 Int

  createdAt             DateTime @default(now())

  protections ProjectProtections[]

  libraryItems LibraryItem[]

  @@map("dc_switch")
}

model DcFuse {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("DcFuseDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("DcFuseHomologation", fields: [homologationFileId], references: [id])

  ratedVoltageV         Float
  ratedCurrentA         Float

  createdAt             DateTime @default(now())

  protections ProjectProtections[]

  libraryItems LibraryItem[]

  @@map("dc_fuse")
}

model AcBreaker {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("AcBreakerDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("AcBreakerHomologation", fields: [homologationFileId], references: [id])

  ratedCurrentA         Float
  curve                 String?
  breakingCapacityKA    Float?
  /// Differential function (disjoncteur différentiel): sensitivity IΔn in mA; null for a plain breaker.
  residualCurrentMA     Int?
  /// 'AC' | 'A' | 'F' | 'B'; null for a plain breaker.
  rcdType               String?

  createdAt             DateTime @default(now())

  protections ProjectProtections[]

  libraryItems LibraryItem[]

  @@map("ac_breaker")
}

model AcIsolator {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("AcIsolatorDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("AcIsolatorHomologation", fields: [homologationFileId], references: [id])

  ratedCurrentA         Float

  createdAt             DateTime @default(now())

  protections ProjectProtections[]

  libraryItems LibraryItem[]

  @@map("ac_isolator")
}

model Cable {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("CableDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("CableHomologation", fields: [homologationFileId], references: [id])

  usage                 CableUsage
  conductor             String
  insulation            String
  standard              String?

  createdAt             DateTime @default(now())

  sections              CableSection[]
  cableRuns             ProjectCableRun[]
  earthingCableFor      ProjectEarthing[]

  libraryItems LibraryItem[]

  @@map("cable")
}

enum CableUsage {
  DC_SOLAR
  AC
  EARTH
}

model CableSection {
  id                String  @id @default(uuid())
  cableId           String
  cable             Cable   @relation(fields: [cableId], references: [id])
  sectionMm2        Float
  izA               Float
  izReferenceMethod String

  @@map("cable_section")
}

model Accessory {
  id                    String   @id @default(uuid())
  ownerCompanyId        String?
  ownerCompany          Company? @relation(fields: [ownerCompanyId], references: [id], onDelete: Restrict)
  brand                 String
  model                 String
  datasheetFileId       String?
  datasheet             File?    @relation("AccessoryDatasheet", fields: [datasheetFileId], references: [id])
  homologationReference String?
  homologationValidTo   DateTime?
  homologationFileId    String?
  catalogStatus         CatalogStatus @default(PUBLISHED)
  datasheetSourceUrl    String?
  importNotes           String?
  homologationDocument  File?    @relation("AccessoryHomologation", fields: [homologationFileId], references: [id])

  kind                  AccessoryKind
  spec                  String?

  createdAt             DateTime @default(now())

  connectorFor         ProjectCablingConfig[] @relation("Connector")
  cableTrayFor         ProjectCablingConfig[] @relation("CableTray")
  distributionBlockFor ProjectEarthing[]      @relation("DistributionBlock")

  libraryItems LibraryItem[]

  @@map("accessory")
}

enum AccessoryKind {
  MC4_CONNECTOR
  DISTRIBUTION_BLOCK
  CABLE_TRAY
  DC_ENCLOSURE
  AC_ENCLOSURE
  EARTH_ROD
  OTHER
}

model Project {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  tier            ProjectTier   @default(STANDARD)
  dossierNumber   String?
  dossierDate     DateTime?
  status          ProjectStatus @default(DRAFT)
  revision        Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client          ProjectClient?
  site            ProjectSite?
  arrayConfig     ProjectArrayConfig?
  protections     ProjectProtections?
  cablingConfig   ProjectCablingConfig?
  cableRuns       ProjectCableRun[]
  structure       ProjectStructure?
  earthing        ProjectEarthing?
  simulation      ProjectSimulation?
  imagery         ProjectImagery?
  offGrid         ProjectOffGrid?
  annexes         ProjectAnnexes?
  jobs            DossierJob[]
  flowStep        ProjectFlowStep?
  billImport      ProjectBillImport?

  @@map("project")
}

enum ProjectFlowStep {
  PROPOSALS
  LOCATIONS
  READY
}

model ProjectBillImport {
  id                     String   @id @default(uuid())
  projectId              String   @unique
  project                Project  @relation(fields: [projectId], references: [id])
  fileId                 String
  file                   File     @relation("ProjectBillImportFile", fields: [fileId], references: [id])
  reading                Json
  warnings               Json
  annualConsumptionKWh   Float?
  averagePriceTNDPerKWh  Float?
  modelId                String
  createdAt              DateTime @default(now())

  @@map("project_bill_import")
}

enum ProjectStatus {
  DRAFT
  GENERATED
  SUBMITTED
  APPROVED
  REJECTED
}

model ProjectClient {
  id                    String  @id @default(uuid())
  projectId             String  @unique
  project               Project @relation(fields: [projectId], references: [id])
  civility              String?
  fullName              String
  clientKind            String
  stegReference         String?
  cin                   String?
  commercialRegister    String?
  phone                 String?
  address               String?
  city                  String?
  governorate           String?
  annualConsumptionKWh  Float?
  subscribedPowerKVA    Float?

  @@map("project_client")
}

model ProjectSite {
  id                       String  @id @default(uuid())
  projectId                String  @unique
  project                  Project @relation(fields: [projectId], references: [id])
  gpsLat                   Float
  gpsLon                   Float
  gridType                 String
  phases                   Int
  mountingType             String
  roofMaterial             String?
  buildingHeightM          Float?
  floors                   Int?
  buildingType             BuildingType?
  tiltDeg                  Float
  azimuthDeg               Float?
  shading                  String?
  shadingNotes             String?
  lightningRod             Boolean @default(false)
  generator                Boolean @default(false)
  installationPointLat     Float?
  installationPointLon     Float?
  technicalRoomPointLat    Float?
  technicalRoomPointLon    Float?
  meterPointLat            Float?
  meterPointLon            Float?
  earthPitPointLat         Float?
  earthPitPointLon         Float?
  equipmentLocation        String?

  @@map("project_site")
}

model ProjectArrayConfig {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id])
  moduleId        String
  module          PvModule @relation(fields: [moduleId], references: [id])
  tMinC           Float    @default(-10)
  tMaxC           Float    @default(85)
  rowsDescription String?

  inverters       ProjectArrayInverter[]

  @@map("project_array_config")
}

model ProjectArrayInverter {
  id                String             @id @default(uuid())
  arrayConfigId     String
  arrayConfig       ProjectArrayConfig @relation(fields: [arrayConfigId], references: [id])
  inverterId        String
  inverter          Inverter           @relation(fields: [inverterId], references: [id])
  phaseConnection   String?

  mppts             ProjectArrayMppt[]

  @@map("project_array_inverter")
}

model ProjectArrayMppt {
  id                 String               @id @default(uuid())
  arrayInverterId     String
  arrayInverter       ProjectArrayInverter @relation(fields: [arrayInverterId], references: [id])
  stringsInParallel   Int
  modulesPerString    Int

  @@map("project_array_mppt")
}

model ProjectProtections {
  id                       String      @id @default(uuid())
  projectId                String      @unique
  project                  Project     @relation(fields: [projectId], references: [id])
  dcSpdId                  String
  dcSpd                    Spd         @relation("DcSpd", fields: [dcSpdId], references: [id])
  dcSwitchId               String
  dcSwitch                 DcSwitch    @relation(fields: [dcSwitchId], references: [id])
  dcFuseId                 String?
  dcFuse                   DcFuse?     @relation(fields: [dcFuseId], references: [id])
  acBreakerId              String
  acBreaker                AcBreaker   @relation(fields: [acBreakerId], references: [id])
  acSpdId                  String
  acSpd                    Spd         @relation("AcSpd", fields: [acSpdId], references: [id])
  acIsolatorId             String?
  acIsolator               AcIsolator? @relation(fields: [acIsolatorId], references: [id])
  mainBreakerRatedCurrentA  Float?
  mainBreakerSensitivityMA  Int?
  spdToEquipmentDistanceM   Float       @default(1)
  equipmentImpulseWithstandKV Float     @default(4)

  @@map("project_protections")
}

model ProjectCableRun {
  id               String      @id @default(uuid())
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id])
  circuitType      CircuitType
  label            String
  cableId          String
  cable            Cable       @relation(fields: [cableId], references: [id])
  sectionMm2       Float
  lengthM          Float
  installMethod    String
  ambientContext   String
  groupedCircuits  Int         @default(1)
  layers           Int         @default(1)

  @@map("project_cable_run")
}

enum CircuitType {
  DC
  AC
}

model ProjectCablingConfig {
  id                 String     @id @default(uuid())
  projectId          String     @unique
  project            Project    @relation(fields: [projectId], references: [id])
  cosPhi             Float      @default(0.8)
  lambdaOhmPerM      Float
  maxVoltageDropPct  Float      @default(3)
  maxAcVoltageDropPct Float     @default(1)
  connectorId        String?
  connector          Accessory? @relation("Connector", fields: [connectorId], references: [id])
  cableTrayId        String?
  cableTray          Accessory? @relation("CableTray", fields: [cableTrayId], references: [id])

  @@map("project_cabling_config")
}

model ProjectStructure {
  id                   String  @id @default(uuid())
  projectId            String  @unique
  project              Project @relation(fields: [projectId], references: [id])
  material             String
  frameDescription     String?
  frameCount           Int?
  railsDescription    String?
  fixingDescription    String?
  ballastPerFrame      Int?
  ballastMassKg        Float?
  ballastType          String?
  structureWeightN     Float?
  heightHM             Float?
  depthDM              Float?
  windSpeedKmh         Float   @default(120)
  liftCoeffNPerM2      Float?
  dragCoeffNPerM2      Float?
  tieDownCables        String?
  structureAttestationFileId String?
  structureAttestation File?   @relation("ProjectStructureAttestation", fields: [structureAttestationFileId], references: [id])

  @@map("project_structure")
}

model ProjectEarthing {
  id                       String     @id @default(uuid())
  projectId                String     @unique
  project                  Project    @relation(fields: [projectId], references: [id])
  mainEarthSectionMm2      Float
  frameEarthSectionMm2     Float
  earthToPitSectionMm2     Float
  rodCount                 Int
  useBuildingEarth         Boolean    @default(false)
  rodLengthM               Float
  rodSpacingCm             Float?
  pitSizeCm                String?
  targetResistanceOhm      Float
  earthCableId             String
  earthCable               Cable      @relation(fields: [earthCableId], references: [id])
  distributionBlockId      String?
  distributionBlock        Accessory? @relation("DistributionBlock", fields: [distributionBlockId], references: [id])

  @@map("project_earthing")
}

model ProjectSimulation {
  id                     String  @id @default(uuid())
  projectId              String  @unique
  project                Project @relation(fields: [projectId], references: [id])
  source                 String
  pvsystReportFileId     String?
  pvsystReport           File?   @relation("ProjectSimulationPvsystReport", fields: [pvsystReportFileId], references: [id])
  annualProductionKWh    Float?
  specificYieldKWhPerKWp Float?
  performanceRatioPct    Float?
  systemLossesPct        Float?

  @@map("project_simulation")
}

model PvgisYieldCache {
  id                     String   @id @default(uuid())
  latRounded             Float
  lonRounded             Float
  tiltDeg                Float
  azimuthDeg             Float
  specificYieldKWhPerKWp Float
  fetchedAt              DateTime @default(now())

  @@unique([latRounded, lonRounded, tiltDeg, azimuthDeg])
  @@map("pvgis_yield_cache")
}

model PvgisWeatherCache {
  id                 String   @id @default(uuid())
  latRounded         Float
  lonRounded         Float
  tiltDeg            Float
  azimuthDeg         Float
  year               Int
  inPlaneDataJson    Json
  horizontalDataJson Json
  fetchedAt          DateTime @default(now())

  @@unique([latRounded, lonRounded, tiltDeg, azimuthDeg, year])
  @@map("pvgis_weather_cache")
}

model ProjectImagery {
  id                   String  @id @default(uuid())
  projectId            String  @unique
  project              Project @relation(fields: [projectId], references: [id])
  situationImageFileId String?
  situationImage       File?   @relation("SituationImage", fields: [situationImageFileId], references: [id])
  implantationImageFileId String?
  implantationImage    File?   @relation("ImplantationImage", fields: [implantationImageFileId], references: [id])
  southArrowDeg        Float?
  geometry             Json
  imageryProvider      String?

  @@map("project_imagery")
}

model ProjectOffGrid {
  id                        String  @id @default(uuid())
  projectId                 String  @unique
  project                   Project @relation(fields: [projectId], references: [id])
  dailyLoadKWh              Float
  autonomyDays              Float
  batteryChemistry          String
  batteryVoltageV           Int
  maxDepthOfDischargePct    Float
  batteryModel              String?
  chargeControllerModel     String?

  @@map("project_off_grid")
}

model ProjectAnnexes {
  id                        String  @id @default(uuid())
  projectId                 String  @unique
  project                   Project @relation(fields: [projectId], references: [id])
  cinFileId                 String?
  cin                       File?   @relation("AnnexCin", fields: [cinFileId], references: [id])
  commercialRegisterFileId  String?
  commercialRegister        File?   @relation("AnnexCommercialRegister", fields: [commercialRegisterFileId], references: [id])
  stegContractFileId        String?
  stegContract              File?   @relation("AnnexStegContract", fields: [stegContractFileId], references: [id])
  lastPaidBillFileId        String?
  lastPaidBill              File?   @relation("AnnexLastPaidBill", fields: [lastPaidBillFileId], references: [id])
  /// The distributor's ANME acceptance letter for the module (annex N°11).
  moduleAcceptanceFileId    String?
  moduleAcceptance          File?   @relation("AnnexModuleAcceptance", fields: [moduleAcceptanceFileId], references: [id])

  extraFiles                ProjectAnnexExtraFile[]

  @@map("project_annexes")
}

model ProjectAnnexExtraFile {
  id          String         @id @default(uuid())
  annexesId   String
  annexes     ProjectAnnexes @relation(fields: [annexesId], references: [id])
  fileId      String
  file        File           @relation("ProjectAnnexExtraFile", fields: [fileId], references: [id])

  @@map("project_annex_extra_file")
}

model DossierJob {
  id              String      @id @default(uuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id])
  status          JobStatus   @default(PENDING)
  failedStep      String?
  failureReason   String?
  inputSnapshot   Json
  startedAt       DateTime    @default(now())
  completedAt     DateTime?

  docxFileId       String?
  docx             File?    @relation("DossierJobDocx", fields: [docxFileId], references: [id])
  pdfFileId        String?
  pdf              File?    @relation("DossierJobPdf", fields: [pdfFileId], references: [id])
  annexesPdfFileId String?
  annexesPdf       File?    @relation("DossierJobAnnexesPdf", fields: [annexesPdfFileId], references: [id])
  /// French warnings of a finished job (e.g. an unreadable annex left out): a string[].
  warnings         Json     @default("[]")

  checkResults    DossierCheckResult[]
  usageLogs       ClaudeUsageLog[]

  @@map("dossier_job")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

model DossierCheckResult {
  id        String     @id @default(uuid())
  jobId     String
  job       DossierJob @relation(fields: [jobId], references: [id])
  checkId   String
  level     String
  pass      Boolean
  message   String

  @@map("dossier_check_result")
}

model ClaudeUsageLog {
  id            String     @id @default(uuid())
  jobId         String
  job           DossierJob @relation(fields: [jobId], references: [id])
  model         String
  inputTokens   Int
  outputTokens  Int
  costUsd       Decimal    @db.Decimal(10, 4)
  createdAt     DateTime   @default(now())

  @@map("claude_usage_log")
}

enum EquipmentKind {
  PV_MODULE
  INVERTER
  SPD
  DC_SWITCH
  DC_FUSE
  AC_BREAKER
  AC_ISOLATOR
  CABLE
  ACCESSORY
}

model LibraryItem {
  id               String        @id @default(uuid())
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind             EquipmentKind
  pvModuleId       String?
  pvModule         PvModule?     @relation(fields: [pvModuleId], references: [id], onDelete: Cascade)
  inverterId       String?
  inverter         Inverter?     @relation(fields: [inverterId], references: [id], onDelete: Cascade)
  spdId            String?
  spd              Spd?          @relation(fields: [spdId], references: [id], onDelete: Cascade)
  dcSwitchId       String?
  dcSwitch         DcSwitch?     @relation(fields: [dcSwitchId], references: [id], onDelete: Cascade)
  dcFuseId         String?
  dcFuse           DcFuse?       @relation(fields: [dcFuseId], references: [id], onDelete: Cascade)
  acBreakerId      String?
  acBreaker        AcBreaker?    @relation(fields: [acBreakerId], references: [id], onDelete: Cascade)
  acIsolatorId     String?
  acIsolator       AcIsolator?   @relation(fields: [acIsolatorId], references: [id], onDelete: Cascade)
  cableId          String?
  cable            Cable?        @relation(fields: [cableId], references: [id], onDelete: Cascade)
  accessoryId      String?
  accessory        Accessory?    @relation(fields: [accessoryId], references: [id], onDelete: Cascade)
  purchasePriceTnd Float         @default(0)
  createdAt        DateTime      @default(now())

  @@unique([companyId, pvModuleId])
  @@unique([companyId, inverterId])
  @@unique([companyId, spdId])
  @@unique([companyId, dcSwitchId])
  @@unique([companyId, dcFuseId])
  @@unique([companyId, acBreakerId])
  @@unique([companyId, acIsolatorId])
  @@unique([companyId, cableId])
  @@unique([companyId, accessoryId])
  @@map("library_item")
}

/// The official lists the catalog is imported from (STEG accepted inverters, ANME accepted
/// panels), stored as files so the worker can annex the page listing the chosen model.
enum CatalogSourceKind {
  STEG_INVERTER_LIST
  ANME_PANEL_LIST
}

model CatalogSourceDocument {
  id        String            @id @default(uuid())
  kind      CatalogSourceKind @unique
  fileId    String
  file      File              @relation("CatalogSourceDocumentFile", fields: [fileId], references: [id])
  sourceUrl String
  fetchedAt DateTime          @default(now())

  @@map("catalog_source_document")
}
