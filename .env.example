# Local development settings. Run `npm run setup:env` to copy this file to
# apps/web/.env and packages/db/.env (both are gitignored — never commit them).
# Two copies are needed because Next.js and Prisma each read the .env of the
# directory they are started from.

# Local Postgres from docker-compose.dev.yml. Never point this at the production
# database (the one behind the SSH tunnel on port 5433).
DATABASE_URL=postgresql://dossipv:dev@localhost:5432/dossipv

# Where uploaded files are stored. Relative paths resolve from apps/web.
FILE_STORAGE_ROOT=./.file-storage

# Required by @dossipv/document-text to call the Claude API.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
