{
  "permissions": {
    "allow": [
      "Bash(ssh dossipv-server docker ps)",
      "Bash(ssh dossipv-server docker ps -a)",
      "Bash(ssh dossipv-server docker logs --tail 100 dossipv-app-1)",
      "Bash(ssh dossipv-server docker logs --tail 200 dossipv-app-1)",
      "Bash(ssh dossipv-server docker logs --tail 100 dossipv-postgres-1)",
      "Bash(ssh dossipv-server docker logs --tail 200 dossipv-postgres-1)",
      "Bash(ssh dossipv-server docker inspect dossipv-app-1)",
      "Bash(ssh dossipv-server docker inspect dossipv-postgres-1)",
      "Bash(ssh dossipv-server cat /etc/nginx/sites-available/dossipv)"
    ],
    "ask": [
      "Bash(ssh dossipv-server docker exec *)",
      "Bash(ssh dossipv-server docker restart *)",
      "Bash(ssh dossipv-server docker start *)",
      "Bash(ssh dossipv-server docker stop *)",
      "Bash(ssh dossipv-server *docker compose*)",
      "Bash(ssh dossipv-server sudo nginx -t*)",
      "Bash(ssh dossipv-server sudo systemctl reload nginx*)"
    ],
    "deny": [
      "Bash(ssh dossipv-server *erpsonalim*)",
      "Bash(ssh dossipv-server *TRT*)",
      "Bash(ssh dossipv-server *labo-zribi*)",
      "Bash(ssh dossipv-server *gemini*)",
      "Bash(ssh dossipv-server *km-reader*)",
      "Bash(ssh dossipv-server *docker rm*)",
      "Bash(ssh dossipv-server *docker system*)",
      "Bash(ssh dossipv-server *docker volume*)",
      "Bash(ssh dossipv-server *docker compose down*)"
    ]
  }
}
