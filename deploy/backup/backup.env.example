# Settings for deploy/backup/backup.sh and restore.sh. Copy to /etc/dossipv/backup.env
# (chmod 600, owned by root). Every line is optional: the values shown are the defaults.

# Where the local copies live (daily/, weekly/, pre-restore/, restore-check/).
#BACKUP_ROOT=/var/backups/dossipv
#BACKUP_KEEP_DAILY=7
#BACKUP_KEEP_WEEKLY=4
# ISO weekday kept as the weekly backup: 1 = Monday … 7 = Sunday.
#BACKUP_WEEKLY_DAY=7

# Off-site copy: an rclone remote (and optional path) configured with `rclone config` as root.
# Empty = local copies only. Use an encrypted (crypt) remote: the backups hold client personal data.
# See docs/runbooks/backup-and-restore.md for examples.
#BACKUP_RCLONE_REMOTE=dossipv-offsite:

# Optional dead man's switch: pinged after each successful backup (healthchecks.io, Better Stack
# heartbeat…); the service alerts when the ping stops arriving.
#BACKUP_HEARTBEAT_URL=

# Must match deploy/docker-compose.yml.
#POSTGRES_CONTAINER=dossipv-postgres-1
#POSTGRES_DB=dossipv
#POSTGRES_USER=dossipv
#FILES_VOLUME=dossipv_files
# restore.sh only: containers stopped during a production restore, and the drill database.
#APP_CONTAINERS="dossipv-app-1 dossipv-worker-1"
#SCRATCH_DB=dossipv_restore_check
